{
    "compilerOptions": {
        "baseUrl": ".",
        "ignoreDeprecations": "6.0",
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "types": ["@revenge-mod/types"],

        "paths": {
            "@/types/*": ["./types/*"],
            "@shared/*": ["./shared/*"]
        }
    },
    "include": ["plugins", "types"],
    "exclude": ["plugins/*/build"]
}
